# 이 파일을 .env로 복사해서 값을 채우세요. .env는 git에 올리지 않습니다.

# Supabase (비워두면 메모리 DB로 동작: 서버 재시작 시 데이터 초기화)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 멀티모달 LLM (OpenAI 호환 Chat Completions API)
# 예) OpenAI:  https://api.openai.com/v1
#     Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
# 비워두면 시연용 대체 응답을 돌려줍니다.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# AI 호출 제한 시간(초). 넘기면 대체 응답으로 전환
LLM_TIMEOUT=8
