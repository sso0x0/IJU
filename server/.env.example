# 이 파일을 .env로 복사해서 값을 채우세요. .env는 git에 올리지 않습니다.

# Supabase (비워두면 메모리 DB로 동작: 서버 재시작 시 데이터 초기화)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 멀티모달 LLM (OpenAI 호환 Chat Completions API)
# 예) OpenAI:  https://api.openai.com/v1
#     Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
# 비워두면 시연용 대체 응답을 돌려줍니다.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# AI 호출 제한 시간(초). 해상도를 올리면 오래 걸리니 넉넉하게
LLM_TIMEOUT=30

# AI에 보내는 사진 크기(긴 변 px)와 JPEG 품질. 손글씨는 클수록 잘 읽지만 느려짐
IMAGE_MAX_SIDE=3072
IMAGE_QUALITY=95

# 메뉴판을 가로 띠 몇 조각으로 나눠 동시에 읽을지. 0=자동(세로 3, 가로 2), 1=안 나눔. 조각 수만큼 요금이 늘어남
IMAGE_TILES=0

# true면 AI 실패 시 시연용 고정 메뉴(삼겹살 등)를 돌려줌. 평소엔 false
DEMO_FALLBACK=false

# 영수증 유효 기간(일). 기본 7. 인터넷 영수증 사진으로 테스트할 때만 늘리기 (예: 365)
RECEIPT_VALID_DAYS=7

# 영수증 테스트용 가게(app/test_stores.py)를 메모리 DB에 추가. 테스트할 때만 true
RECEIPT_TEST_STORES=false

# 카카오 로컬 API REST 키. 영수증 가게 주소를 좌표로 바꿔 주문 지도에 핀을 찍음 (개발자1)
KAKAO_REST_API_KEY=

# 로그인 (개발자1). AUTH_SECRET은 아무 긴 랜덤 문자열 (python -c "import secrets;print(secrets.token_urlsafe(32))")
# 비우면 서버를 재시작할 때마다 모두 다시 로그인해야 함
AUTH_SECRET=
TOKEN_DAYS=30
# 구글 로그인을 허용할 OAuth 클라이언트 ID. 웹·Android 등 여러 개면 쉼표로 구분
GOOGLE_CLIENT_IDS=
