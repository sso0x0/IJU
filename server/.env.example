# 이 파일을 .env로 복사해서 값을 채우세요. .env는 git에 올리지 않습니다.
# 값을 비워 두면 괄호 안 기본값으로 동작합니다.

# ---------- DB ----------
# Supabase 프로젝트 URL과 service_role 키 (비우면 메모리 DB: 서버를 껐다 켜면 데이터가 사라짐)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------- AI (메뉴판 인식 · 번역 · 문장 · 영수증) ----------
# OpenAI 호환 Chat Completions API. 셋 다 채워야 켜집니다 (비우면 AI 없이 동작)
#   OpenAI:  https://api.openai.com/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# AI 호출 제한 시간(초, 기본 30)
LLM_TIMEOUT=30

# 메뉴판 사진: 긴 변 px(기본 3072) · JPEG 품질(기본 95). 클수록 손글씨를 잘 읽지만 느려짐
IMAGE_MAX_SIDE=3072
IMAGE_QUALITY=95
# 메뉴판을 가로 띠 몇 조각으로 나눠 동시에 읽을지. 0=자동(세로 사진 3, 가로 사진 2), 1=안 나눔. 조각 수만큼 요금이 늘어남
IMAGE_TILES=0
# true면 AI가 메뉴를 못 읽었을 때 시연용 고정 메뉴(김치찌개·제육볶음·삼겹살)를 돌려줌 (기본 false)
DEMO_FALLBACK=false

# ---------- 영수증 인증 ----------
# 시연 모드(기본 true): 아무 사진이나 인증 통과. 실제 운영 전에 false로
RECEIPT_ACCEPT_ANY=true
# 발행 후 며칠 안의 영수증만 인정(기본 7). RECEIPT_ACCEPT_ANY=false일 때만 씀
RECEIPT_VALID_DAYS=7

# ---------- 지도 ----------
# 카카오 로컬 API REST 키. 가게 주소 ↔ 좌표 변환 (내 지도 핀). 비우면 좌표·주소 없이 저장
KAKAO_REST_API_KEY=

# 가게 QR이 가리킬 서버 주소. 폰으로 찍어야 하니 localhost 말고 노트북 IP로 (예: http://192.168.0.10:8000)
# 비우면 요청이 들어온 주소를 그대로 씀
PUBLIC_BASE_URL=

# ---------- 로그인 ----------
# 로그인 토큰 서명 키. 긴 랜덤 문자열 (python -c "import secrets;print(secrets.token_urlsafe(32))")
# 비우면 서버를 재시작할 때마다 모두 다시 로그인해야 함
AUTH_SECRET=
# 로그인 유지 기간(일, 기본 30)
TOKEN_DAYS=30
# 구글 로그인을 허용할 OAuth 클라이언트 ID. 앱이 쓰는 웹 클라이언트 ID와 같아야 함. 여러 개면 쉼표로 구분
GOOGLE_CLIENT_IDS=
